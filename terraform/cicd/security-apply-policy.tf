# Generated by IAM Access Analyzer
data "aws_iam_policy_document" "security_apply" {
  statement {
    sid    = "GlobalActions"
    effect = "Allow"
    actions = [
      "autoscaling:DescribeTags",
      "cloudtrail:AddTags",
      "cloudtrail:DescribeTrails",
      "cloudtrail:ListTags",
      "config:DescribeConfigRules",
      "config:DescribeDeliveryChannels",
      "config:ListTagsForResource",
      "config:PutDeliveryChannel",
      "ec2:DescribeFlowLogs",
      "ec2:DescribeTags",
      "ecs:ListClusters",
      "ecs:ListServices",
      "ecs:ListTaskDefinitions",
      "events:DescribeRule",
      "events:ListTagsForResource",
      "events:ListTargetsByRule",
      "events:PutRule",
      "events:PutTargets",
      "guardduty:CreateDetector",
      "kms:CreateKey",
      "kms:ListAliases",
      "logs:DescribeLogGroups",
      "logs:ListTagsForResource",
      "organizations:ListAWSServiceAccessForOrganization",
      "s3:GetAccountPublicAccessBlock",
      "s3:GetBucketAcl",
      "s3:GetBucketCORS",
      "s3:GetBucketPolicy",
      "s3:PutAccountPublicAccessBlock",
      "securityhub:BatchEnableStandards",
      "securityhub:DescribeHub",
      "securityhub:EnableImportFindingsForProduct",
      "securityhub:EnableSecurityHub",
      "securityhub:GetEnabledStandards",
      "securityhub:ListEnabledProductsForImport",
      "securityhub:UpdateSecurityHubConfiguration",
      "sts:GetCallerIdentity",
      "wafv2:ListTagsForResource",
      "wafv2:TagResource"
    ]
    resources = ["*"]
  }

  statement {
    sid       = "EC2CreateTags"
    effect    = "Allow"
    actions   = ["ec2:CreateTags"]
    resources = ["*"]
    condition {
      test     = "StringEquals"
      variable = "ec2:CreateAction"
      values   = ["CreateFlowLogs"]
    }
  }

  statement {
    sid       = "EC2CreateTagsExisting"
    effect    = "Allow"
    actions   = ["ec2:CreateTags"]
    resources = ["*"]
    condition {
      test     = "StringEquals"
      variable = "aws:ResourceTag/Project"
      values   = [var.project]
    }
  }

  statement {
    sid    = "CloudTrail"
    effect = "Allow"
    actions = [
      "cloudtrail:CreateTrail",
      "cloudtrail:GetTrailStatus",
      "cloudtrail:StartLogging"
    ]
    resources = [
      "arn:aws:cloudtrail:${var.aws_region}:${data.aws_caller_identity.current.account_id}:trail/${var.project}-${var.environment}-*"
    ]
  }

  statement {
    sid     = "ConfigRule"
    effect  = "Allow"
    actions = ["config:PutConfigRule"]
    resources = [
      "arn:aws:config:${var.aws_region}:${data.aws_caller_identity.current.account_id}:config-rule/${var.project}-${var.environment}-*"
    ]
  }

  statement {
    sid    = "ConfigRecorder"
    effect = "Allow"
    actions = [
      "config:DescribeConfigurationRecorderStatus",
      "config:DescribeConfigurationRecorders",
      "config:PutConfigurationRecorder",
      "config:StartConfigurationRecorder"
    ]
    resources = [
      "arn:aws:config:${var.aws_region}:${data.aws_caller_identity.current.account_id}:configuration-recorder/*"
    ]
  }

  statement {
    sid    = "ConfigRemediation"
    effect = "Allow"
    actions = [
      "config:DescribeRemediationConfigurations",
      "config:PutRemediationConfigurations"
    ]
    resources = [
      "arn:aws:config:${var.aws_region}:${data.aws_caller_identity.current.account_id}:remediation-configuration/*"
    ]
  }

  statement {
    sid     = "EC2FlowLogs"
    effect  = "Allow"
    actions = ["ec2:CreateFlowLogs"]
    resources = [
      "arn:aws:ec2:${var.aws_region}:${data.aws_caller_identity.current.account_id}:vpc-flow-log/*"
    ]
  }

  statement {
    sid     = "ECSCluster"
    effect  = "Allow"
    actions = ["ecs:ListContainerInstances"]
    resources = [
      "arn:aws:ecs:${var.aws_region}:${data.aws_caller_identity.current.account_id}:cluster/*"
    ]
  }

  statement {
    sid     = "ECSContainerInstance"
    effect  = "Allow"
    actions = ["ecs:ListTasks"]
    resources = [
      "arn:aws:ecs:${var.aws_region}:${data.aws_caller_identity.current.account_id}:container-instance/*/*"
    ]
  }

  statement {
    sid    = "GuardDutyDetector"
    effect = "Allow"
    actions = [
      "guardduty:GetDetector",
      "guardduty:UpdateDetector"
    ]
    resources = [
      "arn:aws:guardduty:${var.aws_region}:${data.aws_caller_identity.current.account_id}:detector/*"
    ]
  }

  statement {
    sid    = "IAMPolicy"
    effect = "Allow"
    actions = [
      "iam:CreatePolicy",
      "iam:GetPolicy",
      "iam:GetPolicyVersion"
    ]
    resources = [
      "arn:aws:iam::${data.aws_caller_identity.current.account_id}:policy/${var.project}-${var.environment}-*"
    ]
  }

  statement {
    sid    = "IAMRole"
    effect = "Allow"
    actions = [
      "iam:AttachRolePolicy",
      "iam:CreateRole",
      "iam:GetRole",
      "iam:GetRolePolicy",
      "iam:ListAttachedRolePolicies",
      "iam:ListRolePolicies",
      "iam:PutRolePolicy"
    ]
    resources = [
      "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/${var.project}-${var.environment}-*"
    ]
  }

  statement {
    sid     = "IAMServiceLinkedRole"
    effect  = "Allow"
    actions = ["iam:CreateServiceLinkedRole"]
    resources = [
      "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-service-role/*"
    ]
    condition {
      test     = "StringEquals"
      variable = "iam:AWSServiceName"
      values = [
        "config.amazonaws.com",
        "guardduty.amazonaws.com",
        "securityhub.amazonaws.com"
      ]
    }
  }

  statement {
    sid     = "IAMPassRole"
    effect  = "Allow"
    actions = ["iam:PassRole"]
    resources = [
      "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/${var.project}-${var.environment}-*"
    ]
    condition {
      test     = "StringEquals"
      variable = "iam:PassedToService"
      values = [
        "lambda.amazonaws.com",
        "config.amazonaws.com",
        "vpc-flow-logs.amazonaws.com",
        "cloudtrail.amazonaws.com",
        "ssm.amazonaws.com",
        "events.amazonaws.com"
      ]
    }
  }

  statement {
    sid     = "KMSAlias"
    effect  = "Allow"
